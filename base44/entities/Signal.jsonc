{
  "name": "Signal",
  "type": "object",
  "properties": {
    "bot_name": {
      "type": "string"
    },
    "bot_id": {
      "type": "string"
    },
    "strategy": {
      "type": "string"
    },
    "exchange": {
      "type": "string",
      "default": "kraken"
    },
    "pair": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell",
        "hold"
      ]
    },
    "confidence": {
      "type": "number",
      "default": 0
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "reason": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "timeframe": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "consumed",
        "accepted",
        "rejected",
        "expired",
        "executed"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray",
        "red",
        "gray",
        "green"
      ],
      "default": "new",
      "description": "consumed al evaluarla en tradingLoop para que no se ejecute dos veces"
    },
    "expires_at": {
      "type": "string"
    },
    "min_required_quote": {
      "type": "number"
    },
    "available_quote": {
      "type": "number"
    },
    "order_quote": {
      "type": "number"
    },
    "spread_pct": {
      "type": "number"
    },
    "volume_score": {
      "type": "number"
    },
    "raw_data": {
      "type": "string"
    }
  },
  "required": [
    "bot_name",
    "bot_id",
    "strategy",
    "exchange",
    "pair",
    "side",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}