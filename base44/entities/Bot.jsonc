{
  "name": "Bot",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "trend_following",
        "mean_reversion",
        "ai_sentiment",
        "risk_guardian"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "stopped"
      ],
      "default": "stopped"
    },
    "exchange": {
      "type": "string",
      "enum": [
        "kraken"
      ],
      "default": "kraken"
    },
    "trading_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "demo"
    },
    "live_enabled": {
      "type": "boolean",
      "default": false
    },
    "strategy": {
      "type": "string",
      "enum": [
        "first_live_trade",
        "micro_scalp",
        "micro_scalp_test",
        "ema_cross",
        "mean_reversion"
      ],
      "default": "ema_cross"
    },
    "master_strategy_version": {
      "type": "string",
      "default": "BotCo Master Strategy v1"
    },
    "master_strategy_instructions": {
      "type": "string",
      "description": "Institutional trading doctrine used by BotCo bots"
    },
    "min_signal_score": {
      "type": "number",
      "default": 75
    },
    "timeframe": {
      "type": "number",
      "default": 5
    },
    "max_order_usd": {
      "type": "number",
      "default": 10
    },
    "max_order_quote": {
      "type": "number",
      "default": 10
    },
    "quote_currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR"
      ],
      "default": "USD"
    },
    "capital": {
      "type": "number",
      "default": 0
    },
    "profit": {
      "type": "number",
      "default": 0
    },
    "risk_level": {
      "type": "number",
      "default": 0
    },
    "trades_count": {
      "type": "number",
      "default": 0
    },
    "win_rate": {
      "type": "number",
      "default": 0
    },
    "max_drawdown": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_loss": {
      "type": "number",
      "default": 0.2
    },
    "take_profit": {
      "type": "number",
      "default": 0.05
    },
    "trailing_stop": {
      "type": "number",
      "default": 1
    },
    "max_risk_per_trade": {
      "type": "number",
      "default": 0.5
    },
    "daily_loss_limit": {
      "type": "number",
      "default": 3
    },
    "consecutive_loss_pause": {
      "type": "number",
      "default": 3
    },
    "last_run_at": {
      "type": "string"
    },
    "last_signal": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "last_order_at": {
      "type": "string"
    },
    "cooldown_until": {
      "type": "string"
    },
    "icon_color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}