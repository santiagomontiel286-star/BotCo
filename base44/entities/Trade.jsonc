{
  "name": "Trade",
  "type": "object",
  "properties": {
    "exchange": {
      "type": "string",
      "enum": [
        "kraken"
      ],
      "default": "kraken"
    },
    "mode": {
      "type": "string",
      "enum": [
        "demo",
        "live",
        "real"
      ],
      "default": "demo",
      "description": "demo for paper trading, live for real Kraken orders; real is kept for old records"
    },
    "bot_name": {
      "type": "string"
    },
    "pair": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "entry_price": {
      "type": "number"
    },
    "exit_price": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "profit_loss": {
      "type": "number"
    },
    "profit_loss_percent": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "cancelled"
      ]
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "entry_date": {
      "type": "string"
    },
    "exit_date": {
      "type": "string"
    },
    "exchange_order_id": {
      "type": "string"
    },
    "close_order_id": {
      "type": "string"
    },
    "signal_reason": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "fees": {
      "type": "number",
      "default": 0
    },
    "raw_response": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "bot_name",
    "pair",
    "side",
    "status"
  ]
}