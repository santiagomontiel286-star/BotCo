{
  "name": "RiskConfig",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "agresivo",
        "equilibrado",
        "cauteloso"
      ],
      "default": "equilibrado",
      "description": "Perfil de riesgo: fija marco temporal, stop, objetivo y límites"
    },
    "timeframe_minutes": {
      "type": "number",
      "default": 240,
      "description": "Velas de la estrategia: 60, 240 o 1440 minutos"
    },
    "channel_bars": {
      "type": "number",
      "default": 30,
      "description": "Entra cuando el cierre supera el máximo de estas velas"
    },
    "trend_ema": {
      "type": "number",
      "default": 50,
      "description": "Solo entra con el cierre sobre esta EMA (0 = sin filtro)"
    },
    "atr_mult": {
      "type": "number",
      "default": 2,
      "description": "Distancia del stop en ATR"
    },
    "trail_exit_bars": {
      "type": "number",
      "default": 12,
      "description": "Stop móvil: mínimo de estas velas (si no hay objetivo fijo)"
    },
    "max_fee_r": {
      "type": "number",
      "default": 0.4,
      "description": "Coste máximo de comisiones en R"
    },
    "moving_block_pct": {
      "type": "number",
      "default": 10
    },
    "pair_cooldown_minutes": {
      "type": "number",
      "default": 720,
      "description": "Espera antes de repetir un par"
    },
    "kill_switch": {
      "type": "boolean",
      "default": false,
      "description": "Si está activo, tradingLoop no abre ninguna compra (las ventas de cierre nunca se bloquean)"
    },
    "max_open_trades": {
      "type": "number",
      "default": 1
    },
    "max_loss_per_trade_eur": {
      "type": "number",
      "default": 0.5
    },
    "max_daily_loss_eur": {
      "type": "number",
      "default": 1.5
    },
    "max_trades_per_day": {
      "type": "number",
      "default": 3
    },
    "min_reward_risk": {
      "type": "number",
      "default": 1.3
    },
    "max_hold_minutes": {
      "type": "number",
      "default": 20160,
      "description": "Tiempo máximo de una operación; al superarlo se cierra a mercado"
    },
    "session_anchor_utc_hour": {
      "type": "number",
      "default": 7,
      "description": "Obsoleto (estrategia de rango de apertura); tradingLoop ya no lo usa"
    },
    "entry_window_utc_start": {
      "type": "string",
      "default": "00:00"
    },
    "entry_window_utc_end": {
      "type": "string",
      "default": "23:59"
    },
    "stop_rule": {
      "type": "string",
      "enum": [
        "or-low",
        "or-mid"
      ],
      "default": "or-low"
    },
    "target_r": {
      "type": "number",
      "default": 0,
      "description": "Objetivo en múltiplos del riesgo (0 = sin objetivo fijo, stop móvil)"
    },
    "tm_min_edge_points": {
      "type": "number",
      "default": -15,
      "description": "Veto de la Máquina del Tiempo: puntos respecto al equilibrio con comisiones (negativo = solo veta lo claramente malo)"
    },
    "max_order_eur": {
      "type": "number",
      "default": 45
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "default": "paper",
      "description": "paper = simulado con cartera virtual; live = dinero real en Kraken"
    },
    "paper_capital_eur": {
      "type": "number",
      "default": 50,
      "description": "Capital virtual del modo simulado"
    },
    "cooldown_after_stop_minutes": {
      "type": "number",
      "default": 120,
      "description": "Pausa de entradas tras un stop-loss"
    },
    "stoploss_guard_limit": {
      "type": "number",
      "default": 2,
      "description": "Número de stop-loss en 24 h que pausan las entradas"
    },
    "max_drawdown_pct": {
      "type": "number",
      "default": 10,
      "description": "Caída máxima de la sesión antes de pausar las entradas"
    }
  },
  "required": [
    "max_open_trades"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}