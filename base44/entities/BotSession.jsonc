{
  "name": "BotSession",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean",
      "default": false
    },
    "assigned_capital": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string"
    },
    "stopped_at": {
      "type": "string"
    },
    "last_tick_at": {
      "type": "string"
    },
    "last_scanner_at": {
      "type": "string"
    },
    "last_execution_at": {
      "type": "string"
    },
    "last_cycle_summary": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "real",
        "live",
        "demo"
      ],
      "default": "live"
    },
    "risk_profile": {
      "type": "string",
      "enum": [
        "conservador",
        "balanceado",
        "agresivo"
      ],
      "default": "conservador"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "ADAEUR",
        "XRPEUR",
        "DOTEUR",
        "LINKEUR",
        "ATOMEUR",
        "SOLEUR"
      ]
    },
    "total_pnl": {
      "type": "number",
      "default": 0
    },
    "total_trades": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "active",
    "assigned_capital"
  ]
}