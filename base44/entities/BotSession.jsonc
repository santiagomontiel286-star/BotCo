{
  "name": "BotSession",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean",
      "default": false
    },
    "assigned_capital": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string"
    },
    "stopped_at": {
      "type": "string"
    },
    "last_tick_at": {
      "type": "string",
      "description": "\u00faltimo ciclo COMPLETADO con \u00e9xito de tradingLoop"
    },
    "last_scanner_at": {
      "type": "string"
    },
    "last_execution_at": {
      "type": "string"
    },
    "last_cycle_started_at": {
      "type": "string",
      "description": "inicio del ciclo en curso, para detectar cortes por tiempo"
    },
    "last_cycle_status": {
      "type": "string",
      "enum": [
        "running",
        "ok",
        "failed"
      ],
      "enumColors": [
        "blue",
        "green",
        "red"
      ],
      "description": "estado del \u00faltimo ciclo de tradingLoop"
    },
    "last_cycle_error": {
      "type": "string",
      "description": "error del \u00faltimo ciclo fallido"
    },
    "last_cycle_summary": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "real",
        "live",
        "demo"
      ],
      "default": "live"
    },
    "risk_profile": {
      "type": "string",
      "enum": [
        "conservador",
        "balanceado",
        "agresivo"
      ],
      "default": "conservador"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "ADAEUR",
        "XRPEUR",
        "DOTEUR",
        "LINKEUR",
        "ATOMEUR",
        "SOLEUR"
      ]
    },
    "total_pnl": {
      "type": "number",
      "default": 0
    },
    "total_trades": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "active",
    "assigned_capital"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}