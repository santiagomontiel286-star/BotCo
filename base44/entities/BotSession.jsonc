{
  "name": "BotSession",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean",
      "default": false
    },
    "assigned_capital": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "real",
        "demo"
      ],
      "default": "real"
    },
    "risk_profile": {
      "type": "string",
      "enum": [
        "conservador",
        "balanceado",
        "agresivo"
      ],
      "default": "conservador"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "XBTEUR",
        "ETHEUR"
      ]
    },
    "total_pnl": {
      "type": "number",
      "default": 0
    },
    "total_trades": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "active",
    "assigned_capital"
  ]
}