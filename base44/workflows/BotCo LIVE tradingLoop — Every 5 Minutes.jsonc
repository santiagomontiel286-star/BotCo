{
  "name": "BotCo LIVE tradingLoop \u2014 Every 5 Minutes",
  "description": "Ciclo oficial \u00fanico: escanea se\u00f1ales y ejecuta tradingTick para Kraken Spot LIVE.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-05-28T22:20:18.669000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "botco_live_tradingloop_every_5_minutes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "tradingLoop",
            "args": {
              "autoMode": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "tradingLoop"
  }
}